# Public backend origin, without a trailing slash.
# The landing page shows a live aggregate active-user count when this is set.
VITE_API_BASE_URL=https://your-api.example.com

# Deployed Expo web app origin. The Login button routes to /auth/signin here.
VITE_WEB_APP_URL=https://app.your-domain.example

# Browser push configuration. The subscription endpoint must store the Web Push subscription.
VITE_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_PUSH_SUBSCRIPTION_URL=https://your-api.example.com/api/public/push-subscriptions
