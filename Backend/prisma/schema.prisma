generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  password    String?
  profilePic  String?
  googleId    String?          @unique
  pushToken   String?
  cohortNo    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  role        Role             @default(STUDENT)
  semester    Int?             @default(1)
  term        Int?             @default(1)
  cgr         Float?
  cohort      Cohort?          @relation(fields: [cohortNo], references: [cohortNo])
  notificationTone String?
  assignments UserAssignment[]
  activities  UserActivity[]

  @@index([cohortNo])
}

model Subject {
  name        String
  code        String       @id
  createdAt   DateTime     @default(now())
  semester    Int
  term        Int
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  notes       Note[]
}

model Assignment {
  id          String           @id @default(cuid())
  title       String
  dueDate     DateTime?
  openingDate DateTime?
  cohortNo    Int
  subjectCode String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  link        String
  cohort      Cohort           @relation(fields: [cohortNo], references: [cohortNo])
  subject     Subject          @relation(fields: [subjectCode], references: [code])
  users       UserAssignment[]
  notificationSentAt DateTime?

  @@index([dueDate])
  @@unique([title, cohortNo, subjectCode])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  createdAt   DateTime @default(now())
  pdfUrl      String
  updatedAt   DateTime @updatedAt
  subjectCode String
  publicId    String
  subject     Subject  @relation(fields: [subjectCode], references: [code])
}

model Cohort {
  cohortNo    Int          @id @default(autoincrement())
  semester    Int
  term        Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
  users       User[]
}

model UserAssignment {
  id           String     @id @default(cuid())
  userId       String
  assignmentId String
  completed    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([userId, assignmentId])
}

enum Role {
  STUDENT
  TEACHER
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   @default("APP_OPEN")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}